<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

	<name>Assign To Group...</name>
	<id>trlo.assign_group</id>

	<effect>
		<object-type>all</object-type>
		<effects-menu>
			<submenu name="Expanded Groups"/>
		</effects-menu>
	</effect>

	<script>
		<command location="inx" interpreter="python">assign_group.py</command>
	</script>

</inkscape-extension>
